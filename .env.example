# Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control!

# ============================================================================
# Docker Service Ports
# ============================================================================

# PostgreSQL database port
POSTGRES_PORT=5432

# Backend API port
BACKEND_PORT=5208

# Frontend development server port
FRONTEND_PORT=5173

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================

# PostgreSQL connection details
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sms_db
DATABASE_USER=sms_user
DATABASE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Full connection string (alternative to individual values)
# Format: Host=localhost;Port=5432;Database=sms_db;Username=sms_user;Password=your_password
DATABASE_CONNECTION_STRING=Host=${DATABASE_HOST};Port=${DATABASE_PORT};Database=${DATABASE_NAME};Username=${DATABASE_USER};Password=${DATABASE_PASSWORD}

# ============================================================================
# Backend API Configuration
# ============================================================================

# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# API URLs (HTTP and HTTPS)
ASPNETCORE_URLS=http://+:5000;https://+:5001

# HTTPS certificate (for development)
# ASPNETCORE_Kestrel__Certificates__Default__Path=/path/to/cert.pfx
# ASPNETCORE_Kestrel__Certificates__Default__Password=cert_password

# ============================================================================
# JWT Authentication (Future Feature)
# ============================================================================

# JWT secret key (MUST be at least 32 characters)
# Generate with: openssl rand -base64 32
# Or PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REQUIRED_FOR_SECURITY_PURPOSE

# JWT expiry in hours
JWT_EXPIRY_HOURS=8

# JWT issuer and audience
JWT_ISSUER=SchoolManagementSystem
JWT_AUDIENCE=SMSWebClient

# ============================================================================
# Frontend Configuration
# ============================================================================

# Backend API base URL (used by frontend)
VITE_API_BASE_URL=http://localhost:5000

# Application title
VITE_APP_TITLE=School Management System

# Application version (optional)
VITE_APP_VERSION=1.0.0

# Enable debug mode (true/false)
VITE_DEBUG=true

# ============================================================================
# Docker Compose Configuration
# ============================================================================

# Docker Compose project name
COMPOSE_PROJECT_NAME=sms

# PostgreSQL Docker settings
POSTGRES_USER=${DATABASE_USER}
POSTGRES_PASSWORD=${DATABASE_PASSWORD}
POSTGRES_DB=${DATABASE_NAME}

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# Enable detailed error pages (true/false - only for development)
DETAILED_ERRORS=true

# ============================================================================
# CORS Configuration (Development)
# ============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Email Configuration (Future Feature - Phase 2)
# ============================================================================

# SMTP server details (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@schoolms.com
# SMTP_FROM_NAME=School Management System

# ============================================================================
# Cloud Storage (Future Feature - Phase 2)
# ============================================================================

# AWS S3 / Azure Blob Storage (for document uploads)
# STORAGE_PROVIDER=local
# STORAGE_CONTAINER=sms-documents
# STORAGE_CONNECTION_STRING=

# ============================================================================
# Performance & Caching (Future Feature - Phase 2)
# ============================================================================

# Redis connection string (for caching)
# REDIS_CONNECTION_STRING=localhost:6379

# Enable caching (true/false)
# ENABLE_CACHING=false

# ============================================================================
# Monitoring & Analytics (Future Feature - Phase 2)
# ============================================================================

# Application Insights connection string
# APPINSIGHTS_INSTRUMENTATIONKEY=

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable features (true/false)
FEATURE_ATTENDANCE=false
FEATURE_EXAM_MANAGEMENT=false
FEATURE_NOTIFICATIONS=false
FEATURE_DOCUMENT_UPLOAD=false

# ============================================================================
# Security Settings
# ============================================================================

# Enable HTTPS redirection (true/false)
ENABLE_HTTPS_REDIRECTION=false

# Enable HSTS (HTTP Strict Transport Security) - only for production
ENABLE_HSTS=false

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=480

# Failed login attempt threshold (lockout after X attempts)
MAX_FAILED_LOGIN_ATTEMPTS=5

# ============================================================================
# Database Connection Pool Settings
# ============================================================================

# Connection pooling
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=100
DB_CONNECTION_TIMEOUT=30

# ============================================================================
# Development Tools
# ============================================================================

# Enable Swagger in non-development environments (true/false)
ENABLE_SWAGGER=true

# Enable database seeding (true/false)
ENABLE_DATABASE_SEEDING=false

# ============================================================================
# Notes
# ============================================================================
# 
# 1. After copying this file to .env, update all CHANGE_ME values
# 2. Generate secure JWT secret (minimum 32 characters)
# 3. Use strong database password (mix of letters, numbers, symbols)
# 4. Never commit .env file to version control
# 5. Keep .env.example in sync when adding new environment variables
# 6. For production, use environment variables from hosting platform
# 7. Test configuration changes in development before production
#
# ============================================================================
